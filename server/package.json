{
  "name": "@discord/server",
  "version": "0.1.0",
  "main": "dist/index.js",
  "author": "",
  "description": "GraphQL + WebSocket API for the Discord clone",
  "scripts": {
    "dev": "node --watch -r ts-node/register src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "schema": "ts-node src/schema.ts",
    "test:unit": "node -r ts-node/register --test test/core.test.ts",
    "test:e2e": "node -r ts-node/register --test test/workflow.test.ts",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express4": "^1.1.2",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.1.4",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.17.3",
    "graphql": "^16.6.0",
    "graphql-depth-limit": "^1.1.0",
    "graphql-scalars": "^1.23.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "socket.io": "^4.7.4",
    "type-graphql": "^2.0.0-beta.2",
    "typeorm": "^0.3.16",
    "unique-names-generator": "^4.7.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.17.7",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/node": "^20.3.0",
    "eslint": "^8.42.0",
    "socket.io-client": "^4.8.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  },
  "resolutions": {
    "@types/express": "^4.17.17"
  }
}
