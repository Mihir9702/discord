# copy to .env and adjust

# postgres - either a full connection string...
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/connect
# ...or the individual fields (these are the defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASS=postgres
POSTGRES_DB=connect

# api port
PORT=3000

# where the client runs (comma separated for multiple origins)
CLIENT_URL=http://localhost:3001

# "none" when the client and api are on different sites (needs https)
# COOKIE_SAMESITE=lax

# required in production
SESSION_SECRET=change-me
